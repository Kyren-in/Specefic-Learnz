PORT=5000
NODE_ENV=development
JWT_SECRET=YOUR_JWT_SECRET_KEY_CHANGE_THIS

# Google Gemini AI (for RAG search — optional, falls back to keyword search)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Brevo / Sendinblue (for real email OTP — optional, falls back to mock 123456)
BREVO_API_KEY=YOUR_BREVO_API_KEY

# Razorpay (for real payments — optional, falls back to mock checkout)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# SQLite Database path (optional — for Render persistent disk)
# On Render: set DB_PATH=/var/data/database.sqlite
# Default: ./database.sqlite (relative to project root)
# DB_PATH=/var/data/database.sqlite
